---
// Tiger GPU Pro。移植自 design/Tiger GPU Pro.dc.html，版面與文案一字不改。
//
// 全站規則第 2 條：寫「A to A」不寫「A2A」。這頁通篇都是。
// 交付說明第 3 節最後一行：不提 SI 經銷商體系。原型沒提，我也沒加。
//
// 三個跟其他頁不同的地方，都照原型：
//   1. 頂欄用 TopBarSimple（sticky、58px、不縮），見那支檔的說明
//   2. 字型用 fonts="tgpro"（沒覆寫 :root，所以按鈕上的中文走 Noto Sans TC）
//   3. TG-02 那一整區的動畫是純 CSS（12 秒一輪），不需要 JavaScript
import Page from '../../layouts/Page.astro';
import TopBarSimple from '../../components/TopBarSimple.astro';
import GpuHeroRotator, { type Story } from '../../components/GpuHeroRotator.tsx';

// Hero 輪播的五個情境。Agent 和 Skill 刻意分開講（交付說明的要求）。
const stories: Story[] = [
  {
    word: 'Agent',
    label: 'AI Agent',
    pain: 'Agent 跑在自己的筆電，關機就斷線；API Key 掛在個人帳號上，公司看不到。',
    fix: '丟上 TG 變成常駐服務，Key 改由公司實名發放，Agent 不再跟著人下班。',
    mods: ['TG 地端平台', '企業管控與報表'],
  },
  {
    word: 'Skill',
    label: 'Skill 能力包',
    pain: '每個人自己寫、存在自己電腦裡；誰有哪些 Skill、哪一版能用，沒人說得清。',
    fix: 'Skill 上架到 TG 變成部門共用資產：一份版本大家取用，誰呼叫過都有紀錄。',
    mods: ['TG 地端平台', '企業管控與報表'],
  },
  {
    word: '網站',
    label: '網站／前端',
    pain: '放在雲端主機，資料與流量都在別人家；改版部署靠手動搬檔案。',
    fix: 'TG 上開沙盒→測試→上線一條龍，網站與資料留在自己機房。',
    mods: ['TG 地端平台'],
  },
  {
    word: 'App',
    label: 'App／後端服務',
    pain: 'Docker 會寫不會管：伺服器買了，沒人會設定、沒人敢重開。',
    fix: '把 docker-compose 丟給你的 AI，A to A 自動建置、納管，圖形化開關。',
    mods: ['TG 地端平台', 'GPU Plus'],
  },
  {
    word: '自動化流程',
    label: 'n8n 自動化流程',
    pain: '流程在個人電腦的 n8n 上跑，帳號共用，出事查不到誰改的。',
    fix: '地端 n8n 統一部署，每條流程有主人、有版本、有紀錄。',
    mods: ['TG 地端平台', '企業管控與報表'],
  },
];

// TG-03 平台三件套
const modules = [
  {
    n: '模組 1',
    title: 'TG 地端平台',
    body: '伺服器買了沒人會管？TG 把地端 n8n 與微服務的部署變成圖形化開關：環境、埠號、版本，一個畫面控到底。',
    tag: 'A to A 自動部署・沙盒納管',
  },
  {
    n: '模組 2',
    title: 'GPU Plus',
    body: 'GPU 買了，算力卻變不成服務？GPU Plus 自動把算力掛上指定模型、封裝成 API Key。沒有 GPU？我們連硬體一起規劃。',
    tag: '算力 → 模型 API・AI 自動調度',
  },
  {
    n: '模組 3',
    title: '企業管控與報表',
    body: 'Key 發給誰、誰用了多少，一張報表講完。員工實名領 Key、超標可斷，機房排定維護就照表關機。',
    tag: '實名 API Key・計畫性關機',
  },
];

// TG-04 本月用量條。數字為示意，接後台後由管理中心來。
const usage = [
  { who: '法務・陳', pct: 82, n: '412K', warn: false },
  { who: '客服・林', pct: 64, n: '318K', warn: false },
  { who: '業務・張', pct: 41, n: '204K', warn: false },
  { who: '研發・吳', pct: 28, n: '139K', warn: true },
];

const MONO = "font-family:'JetBrains Mono',monospace";
const EYEBROW = `${MONO};font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--tiger-700)`;
const H2 = "font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.02em;line-height:1.15";
const WRAP = 'max-width:1440px;margin:0 auto;padding:0 clamp(16px,5vw,64px)';
const CHIP = `${MONO};font-size:11px;color:var(--tiger-700);border:1px solid var(--border-brand);background:var(--tiger-50);padding:4px 10px`;
---

<Page
  title="Tiger GPU Pro｜TigerAI 虎智科技"
  description="AI 做出來了，放在哪？真正的門檻在最後一哩：部署在哪、算力哪來、誰在控管。Tiger GPU Pro 一次鋪好。"
  fonts="tgpro"
>
  <Fragment slot="head">
    <style>
      /* 原型這頁 inline style 的 keyframes，數值一字不改。
         tg-in       區塊進場：淡入加上移 6px
         tg-wa/tg-wb Hero 換詞。兩組內容一樣，交替用是為了讓同一個元素
                     每次換詞都能重新觸發動畫
         tg-fa/tg-fb 右側資訊卡淡入，同理
         tg-m1/m2/m3 A to A 那三則訊息在兩端之間飛遞，12 秒一輪
         tg-sb       Sandbox 建置中那條從上往下展開
         tg-row      服務列表那一列淡入
         tg-s1..s4   底下四個步驟依序亮成虎金 */
      @keyframes tg-in { from { opacity: 0; transform: translateY(6px) } to { opacity: 1; transform: none } }
      @keyframes tg-wa { from { opacity: 0; transform: translateY(14px) } to { opacity: 1; transform: none } }
      @keyframes tg-wb { from { opacity: 0; transform: translateY(14px) } to { opacity: 1; transform: none } }
      @keyframes tg-fa { from { opacity: 0 } to { opacity: 1 } }
      @keyframes tg-fb { from { opacity: 0 } to { opacity: 1 } }
      @keyframes tg-m1 { 0% { left: 0; opacity: 0 } 3% { left: 0; opacity: 1 } 17% { left: calc(100% - 150px); opacity: 1 } 21% { opacity: 0 } 100% { left: calc(100% - 150px); opacity: 0 } }
      @keyframes tg-m2 { 0%, 24% { right: 0; opacity: 0 } 27% { right: 0; opacity: 1 } 40% { right: calc(100% - 160px); opacity: 1 } 44% { opacity: 0 } 100% { right: calc(100% - 160px); opacity: 0 } }
      @keyframes tg-m3 { 0%, 47% { left: 0; opacity: 0 } 50% { left: 0; opacity: 1 } 60% { left: calc(100% - 132px); opacity: 1 } 64% { opacity: 0 } 100% { left: calc(100% - 132px); opacity: 0 } }
      @keyframes tg-sb { 0%, 62% { transform: scaleY(0) } 70%, 94% { transform: scaleY(1) } 97%, 100% { transform: scaleY(1); opacity: 0 } }
      @keyframes tg-row { 0%, 74% { opacity: 0 } 80%, 94% { opacity: 1 } 98%, 100% { opacity: 0 } }
      @keyframes tg-s1 { 0% { color: #6E6B66; border-color: rgba(14,14,13,.16) } 3%, 20% { color: #C08423; border-color: rgba(192,132,35,.6) } 25%, 100% { color: #6E6B66; border-color: rgba(14,14,13,.16) } }
      @keyframes tg-s2 { 0%, 24% { color: #6E6B66; border-color: rgba(14,14,13,.16) } 27%, 44% { color: #C08423; border-color: rgba(192,132,35,.6) } 49%, 100% { color: #6E6B66; border-color: rgba(14,14,13,.16) } }
      @keyframes tg-s3 { 0%, 47% { color: #6E6B66; border-color: rgba(14,14,13,.16) } 50%, 70% { color: #C08423; border-color: rgba(192,132,35,.6) } 75%, 100% { color: #6E6B66; border-color: rgba(14,14,13,.16) } }
      @keyframes tg-s4 { 0%, 73% { color: #6E6B66; border-color: rgba(14,14,13,.16) } 76%, 94% { color: #C08423; border-color: rgba(192,132,35,.6) } 98%, 100% { color: #6E6B66; border-color: rgba(14,14,13,.16) } }
      @media (prefers-reduced-motion: reduce) {
        * { animation-duration: .001ms !important; animation-delay: 0ms !important }
      }
    </style>
  </Fragment>

  <div style="min-height:100vh;display:flex;flex-direction:column">
    <TopBarSimple />

    <!-- TG-01 Hero + 分流 -->
    <section style="padding:96px 0 64px">
      <div style={WRAP}>
        <span style={`${EYEBROW};animation:tg-in .5s both`}>Tiger GPU Pro・地端部署 × 算力 × 控管</span>
        <GpuHeroRotator stories={stories} client:load />
      </div>
    </section>

    <!-- TG-02 A to A 動畫 -->
    <section style="padding:64px 0 96px;background:#fff;border-top:1px solid var(--border-subtle)">
      <div style={WRAP}>
        <span style={EYEBROW}>A to A 自動部署</span>
        <h2 style={`${H2};margin:12px 0 8px`}>5 分鐘，AI 自動部署。</h2>
        <p style="font-size:15px;line-height:1.7;color:var(--fg-secondary);margin:0 0 32px;max-width:56ch">你只做一件事：把 docker-compose 丟給你的 AI。剩下的，它跟 TG 伺服器上的 OpenCode Agent 自己講。</p>

        <div style="background:#FAFAF8;border:1px solid var(--border-subtle);padding:clamp(20px,3vw,32px);position:relative;overflow:hidden">
          <!-- 右上淡虎金光暈 -->
          <div style="position:absolute;top:-40%;right:-6%;width:420px;height:420px;background:radial-gradient(closest-side,rgba(236,164,43,.12),transparent 70%);pointer-events:none"></div>

          <div data-m="atoa" style="position:relative;display:grid;grid-template-columns:170px 1fr 170px;gap:16px;align-items:stretch">
            <div style="border:1px solid var(--border-subtle);background:#fff;padding:16px;display:grid;gap:6px;align-content:center;justify-items:center;text-align:center">
              <span style={`width:40px;height:40px;border:1px solid var(--border-brand);color:var(--tiger-700);background:var(--tiger-50);display:inline-flex;align-items:center;justify-content:center;${MONO};font-size:13px`}>AI</span>
              <b style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:14px;font-weight:700">你的本機 AI</b>
              <span style={`${MONO};font-size:10px;color:var(--fg-tertiary)`}>開發端</span>
            </div>

            <!-- 訊息在兩端之間飛遞 -->
            <div style="position:relative;min-height:128px;border-bottom:1px dashed rgba(14,14,13,.2)">
              <span style={`position:absolute;top:6px;left:0;${MONO};font-size:11px;border:1px solid var(--border-brand);color:var(--tiger-700);background:var(--tiger-50);padding:4px 8px;white-space:nowrap;animation:tg-m1 12s linear infinite`}>docker-compose.yml →</span>
              <span style={`position:absolute;top:44px;right:0;${MONO};font-size:11px;border:1px solid var(--border-default);color:var(--fg-secondary);background:#fff;padding:4px 8px;white-space:nowrap;animation:tg-m2 12s linear infinite`}>← 環境需求・埠號確認</span>
              <span style={`position:absolute;top:82px;left:0;${MONO};font-size:11px;border:1px solid var(--border-brand);color:var(--tiger-700);background:var(--tiger-50);padding:4px 8px;white-space:nowrap;animation:tg-m3 12s linear infinite`}>環境變數・確認 →</span>
            </div>

            <div style="border:1px solid var(--border-subtle);background:#fff;padding:16px;display:grid;gap:6px;align-content:center;justify-items:center;text-align:center">
              <img src="/assets/logo/color-square-mark.svg" alt="" style="width:40px;height:40px" />
              <b style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:14px;font-weight:700">TG 伺服器 AI</b>
              <span style={`${MONO};font-size:10px;color:var(--fg-tertiary)`}>OpenCode Agent</span>
            </div>
          </div>

          <div style={`position:relative;margin-top:16px;border:1px dashed rgba(192,132,35,.5);background:var(--tiger-50);padding:10px 14px;${MONO};font-size:12px;color:var(--tiger-700);transform-origin:top;animation:tg-sb 12s linear infinite`}>Sandbox 建置中：自動拉映像檔、掛環境變數、開沙盒測試</div>
          <div style={`position:relative;margin-top:8px;border:1px solid var(--border-subtle);background:#fff;padding:10px 14px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;${MONO};font-size:12px;animation:tg-row 12s linear infinite`}><span>opengenie-api・v1.0・port 8443</span><span style="color:var(--success-700)">✓ 已納入 TG 服務列表</span></div>

          <div style="position:relative;display:flex;gap:8px;flex-wrap:wrap;margin-top:20px">
            {['01 交付設定檔', '02 雙端 AI 對話確認', '03 自動建置 Sandbox', '04 納入 TG 統一控管'].map((s, i) => (
              <span style={`${MONO};font-size:11px;border:1px solid rgba(14,14,13,.16);color:#6E6B66;padding:5px 10px;animation:tg-s${i + 1} 12s linear infinite`}>{s}</span>
            ))}
          </div>
        </div>
        <p style={`margin:12px 0 0;${MONO};font-size:11px;color:var(--fg-tertiary)`}>A to A（AI-to-AI）部署示意・外部開發的 ERP 模組、AI 應用同樣可掛載</p>
      </div>
    </section>

    <!-- TG-03 平台三件套 -->
    <section style="padding:96px 0">
      <div style={WRAP}>
        <span style={EYEBROW}>平台三件套</span>
        <h2 style={`${H2};margin:12px 0 32px`}>部署、算力、控管，一套鋪到底。</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
          {modules.map((m) => (
            <div style="background:#fff;border:1px solid var(--border-subtle);padding:24px;display:grid;gap:10px;align-content:start">
              <span style={`${MONO};font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg-tertiary)`}>{m.n}</span>
              <h3 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:20px;font-weight:700;margin:0">{m.title}</h3>
              <p style="margin:0;font-size:14px;line-height:1.7;color:var(--fg-secondary)">{m.body}</p>
              <span style={`justify-self:start;${CHIP}`}>{m.tag}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TG-04 管控報表 -->
    <section style="padding:96px 0;background:#fff;border-top:1px solid var(--border-subtle)">
      <div style={WRAP}>
        <span style={EYEBROW}>老闆看的那一面</span>
        <h2 style={`${H2};margin:12px 0 8px`}>Key 發給誰、用多少，查得到。</h2>
        <p style="font-size:15px;line-height:1.7;color:var(--fg-secondary);margin:0 0 32px;max-width:56ch">員工輸入工號＋帳密才領得到 API Key。每一把 Key 都有名字，每一次調用都有紀錄。</p>

        <div data-m="stack" style="display:grid;grid-template-columns:minmax(260px,1fr) minmax(320px,1.6fr);gap:24px;align-items:start">
          <div style="border:1px solid var(--border-subtle);background:#FAFAF8;padding:20px;display:grid;gap:12px">
            <b style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:14px;font-weight:700">實名領 Key</b>
            <div style={`display:grid;gap:8px;${MONO};font-size:12px`}>
              <span style="border:1px solid var(--border-default);background:#fff;padding:8px 10px;color:var(--fg-secondary)">員工編號　TG-0417</span>
              <span style="border:1px solid var(--border-default);background:#fff;padding:8px 10px;color:var(--fg-secondary)">帳號密碼　••••••••</span>
              <span style="border:1px solid var(--border-brand);background:var(--tiger-50);padding:8px 10px;color:var(--tiger-700)">✓ 核發 sk-tg-a417-••••</span>
            </div>
            <span style="font-size:12px;color:var(--fg-tertiary);line-height:1.6">一人一把、可停用、可設額度。帳號共用查不到誰在用的年代結束了。</span>
          </div>

          <div style="border:1px solid var(--border-subtle);background:#FAFAF8;padding:20px;display:grid;gap:12px">
            <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:baseline">
              <b style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:14px;font-weight:700">本月用量</b>
              <span style={`${MONO};font-size:12px;color:var(--fg-secondary)`}>調用 1.2M 次・流量 84 GB・活躍 Key 47</span>
            </div>
            <div style="display:grid;gap:6px;font-size:12px">
              {usage.map((u) => (
                <div style="display:grid;grid-template-columns:88px 1fr 64px;gap:10px;align-items:center">
                  <span style={MONO}>{u.who}</span>
                  <span style="height:10px;background:var(--slate-100);position:relative">
                    <span style={`position:absolute;inset:0;width:${u.pct}%;background:var(--${u.warn ? 'warning' : 'tiger'}-500)`}></span>
                  </span>
                  <span style={`${MONO};text-align:right`}>{u.n}</span>
                </div>
              ))}
            </div>
            <div style={`display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--border-subtle);padding-top:10px;${MONO};font-size:12px`}><span style="color:var(--fg-secondary)">計畫性關機　下次維護 10/15 02:00</span><span style="color:var(--success-700)">✓ 已排程</span></div>
          </div>
        </div>
        <p style={`margin:16px 0 0;${MONO};font-size:11px;color:var(--fg-tertiary)`}>畫面與數字為示意・n8n 管理狀態、API 調用量、流量統計皆有視覺化報表</p>
      </div>
    </section>

    <!-- TG-05 虎金 CTA -->
    <section style="background:var(--tiger-500);color:#0E0E0D;padding:64px 0">
      <div style={`${WRAP};display:flex;align-items:center;gap:24px;flex-wrap:wrap`}>
        <div style="flex:1;min-width:280px">
          <h2 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(26px,3.5vw,40px);font-weight:800;letter-spacing:-.02em;line-height:1.15;margin:0 0 8px">帶你的架構圖來，30 分鐘。</h2>
          <p style="font-size:15px;line-height:1.7;color:#1A1918;margin:0">我們會告訴你：這個東西放哪、要多少算力、Key 怎麼發。</p>
        </div>
        <a href="/#contact" style="text-decoration:none"><button class="t-btn t-btn--secondary t-btn--lg">預約 30 分鐘諮詢 →</button></a>
      </div>
    </section>

    <!-- 這頁的 Footer 連結色是 #B5B5B2，跟其他頁的 #B5B2AC 差一點，照原型 -->
    <footer style="background:#0E0E0D;color:#878480;padding:24px 0;font-size:12px">
      <div style={`${WRAP};display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between`}>
        <span>© 2026 虎智科技股份有限公司 TigerAI</span>
        <a href="/" style="color:#B5B5B2;text-decoration:none">回首頁 →</a>
      </div>
    </footer>
  </div>
</Page>
