---
// 全站的 HTML 外殼。樣式表的載入順序照 design/*.dc.html 的 <helmet> 一字不差，
// 因為 CSS 的串接順序會影響最後長相，順序換了就可能走樣。
import '../styles/site.css';
// 手機與平板的調整。全部包在 max-width 裡，寬螢幕一條都不生效，
// 所以桌機跟原型的像素比對不受影響。
import '../styles/mobile.css';

interface Props {
  title: string;
  description?: string;
  /** 深色底的頁面（例如首頁 Hero）要換 body 底色，預設暖白 #FAFAF8 */
  bodyBackground?: string;
  /**
   * 字型設定照原型分兩種。原型那 7 頁覆寫了 :root 的 --font-sans／--font-display，
   * Tiger GPU Pro 那頁只改 body 沒動 :root。換成 Noto Sans TC 之後兩者的
   * 字型檔其實一樣了，但 :root 有沒有被覆寫還是會影響到設計系統元件的堆疊順序，
   * 所以保留這個區分。
   */
  fonts?: 'standard' | 'tgpro';
  /** 不要讓搜尋引擎收錄這一頁（404、法遵頁的草稿版本等） */
  noindex?: boolean;
}

const { title, description, bodyBackground, fonts = 'standard', noindex = false } = Astro.props;
const DS = '/ds';

const FONT_CSS = {
  standard: `:root{--font-sans:'Inter','Noto Sans TC',sans-serif;--font-display:'Manrope','Noto Sans TC',sans-serif}` +
    `body{font-family:'Inter','Noto Sans TC',sans-serif}`,
  tgpro: `body{font-family:'Inter','Noto Sans TC',sans-serif}`,
}[fonts];
---

<!DOCTYPE html>
<!-- translate="no" 是全站規則：防瀏覽器翻譯外掛把版面弄壞 -->
<html lang="zh-Hant" translate="no">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="website" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="icon" href="/assets/logo/color-square-mark.svg" type="image/svg+xml" />

  <!-- 中文字型走 Google Fonts 的 Noto Sans TC。
       原型是自架思源黑體的 4 個 OTF，量過線上版是一頁下載 54 MB，不能上線。
       思源黑體（Adobe 發行名 Source Han Sans）和 Noto Sans CJK（Google 發行名）
       是同一套字，Google Fonts 會切成上百個小 woff2 依 unicode-range 按需載入。
       字重 400/500/700/900 對應原本的 Regular/Medium/Bold/Heavy，
       600 是設計系統本來就在用的。換完有跑像素比對，見 README「字型」。 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;900&display=swap" />

  <!-- 設計系統。順序同原型：字型 → 色彩 → 字級 → 基礎 → 元件 → 總表 -->
  <link rel="stylesheet" href={`${DS}/tokens/fonts.css`} />
  <link rel="stylesheet" href={`${DS}/tokens/colors.css`} />
  <link rel="stylesheet" href={`${DS}/tokens/typography.css`} />
  <link rel="stylesheet" href={`${DS}/styles/base.css`} />
  <link rel="stylesheet" href={`${DS}/styles/buttons.css`} />
  <link rel="stylesheet" href={`${DS}/styles/badges.css`} />
  <link rel="stylesheet" href={`${DS}/styles/cards.css`} />
  <link rel="stylesheet" href={`${DS}/styles.css`} />

  <style set:html={FONT_CSS} />
  {bodyBackground && <style set:html={`body{background:${bodyBackground}}`} />}

  <!-- 只有某一頁要的 keyframes 或樣式放這裡，不要塞進共用的 site.css。
       原型每頁的 inline <style> 除了共用那段之外還有各自的東西，
       例如免費資源的 tg-fade／tg-zoom，那些就從這個 slot 進來。 -->
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
