---
// 產品。移植自 design/產品.dc.html，版面與文案一字不改。
//
// ⚠ P0 的 3D 拆解 Demo 還沒做（Robin 指示先跳過）。
//
// 原型那一段是 300vh 的捲動區，內層 sticky 100vh，裡面是 three.js 畫布
// （design/product3d.js，three@0.160 + anime.js，依捲動進度 seek）：
// 主機從正面往左轉 15 度開始，邊轉一圈邊把零件依序高速飛出畫面外，
// 最後停在完整爆炸圖；文案左右交替，字在左時模型往右靠 13%、字在右時往左靠 28%。
//
// 這裡保留了那一段的完整結構、高度、標題、兩段文案和底部提示，只把畫布換成
// 佔位框。這樣下面所有內容的位置完全不會跑掉，其他部分照樣能驗到 0.00%。
// 要補的時候只要把 [data-todo-3d] 那個 div 換成真的畫布就好。
import Page from '../../layouts/Page.astro';
import TopBar from '../../components/TopBar.tsx';
import FooterSlim from '../../components/FooterSlim.astro';

// 六條產品線，對應主控台六站
const lines = [
  { eyebrow: '站 1・對話', title: 'Local GPT', body: '地端 AI 硬體導入，13 部門 AI 同事，資料不出企業。' },
  { eyebrow: '站 2・知識庫', title: 'Advanced RAG', body: '文件變成問得到答案的知識庫，答了有出處。' },
  { eyebrow: '站 3・Workflow', title: 'n8n 自動化', body: '看得見、改得動、過得了稽核的 SOP。' },
  { eyebrow: '站 4・模型', title: 'Ollama 模型管理', body: '開源模型隨裝隨換，不被供應商綁定。' },
  { eyebrow: '站 5・治理', title: 'LiteLLM 治理', body: '部門額度、即時花費、超標熔斷。' },
  { eyebrow: '站 6・儀表板', title: 'GPU 管理中心', body: '叢集排程、用量監控、成本控管：你的 GPU、你的機房。' },
];

const MONO = "font-family:'JetBrains Mono',monospace";
const EYEBROW = `${MONO};font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--tiger-700)`;
const WRAP = 'max-width:1440px;margin:0 auto;padding:0 clamp(16px,5vw,64px)';
const STEP_BOX = 'position:absolute;top:52%;transform:translateY(-50%);width:clamp(200px,23vw,330px);opacity:0;z-index:2;display:grid;gap:10px';
---

<Page
  title="產品｜TigerAI 虎智科技"
  description="同一套系統，三個入口。六條產品線對應主控台六站：你從哪個角色進來，看到的就是你關心的那一面。"
>
  <div style="min-height:100vh;display:flex;flex-direction:column">
    <TopBar current="products" client:load />

    <!-- P0 拆解 Demo：300vh 捲動區，內層 sticky -->
    <section data-m="demo3d" style="position:relative;height:300vh;background:#FAFAF8">
      <div style="position:sticky;top:0;height:100vh;overflow:hidden">
        <div style="max-width:1440px;margin:0 auto;padding:112px clamp(16px,5vw,64px) 0;position:relative;height:100%">
          <div style="position:relative;z-index:3;pointer-events:none">
            <span style={EYEBROW}>Local GPT・產品 Demo</span>
            <h1 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(30px,4.5vw,48px);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin:12px 0 0">一台主機，拆給你看。</h1>
          </div>

          <div style="position:absolute;inset:0;z-index:1;will-change:transform">
            <div aria-hidden="true" style="position:absolute;inset:0;padding-top:56px">
              <!-- 3D 畫布的位置。補的時候換掉這個 div 就好。 -->
              <div
                data-todo-3d
                style="width:100%;height:100%;display:flex;align-items:center;justify-content:center"
              >
                <span style={`${MONO};font-size:12px;color:var(--fg-tertiary);border:1px dashed var(--border-default);padding:14px 20px`}>
                  3D 拆解 Demo（待補）
                </span>
              </div>
            </div>
          </div>

          <div data-m="demo3d-step" style={`${STEP_BOX};left:clamp(16px,5vw,64px)`}>
            <span style={`${MONO};font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--tiger-700)`}>Step 01・打開機殼</span>
            <b style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1.2">算力都在這一箱</b>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--fg-secondary)">GPU、模型、知識庫、Workflow 全裝在同一個機殼裡。跑在你的機房，回應不經任何雲端 API。</p>
            <span style={`${MONO};font-size:11px;color:var(--fg-tertiary)`}>站 1–6 全站服務・13 部門 AI 同事</span>
          </div>

          <div data-m="demo3d-step" style={`${STEP_BOX};right:clamp(16px,5vw,64px)`}>
            <span style={`${MONO};font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--tiger-700)`}>Step 02・拆到底</span>
            <b style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1.2">零件會換，資料不搬家</b>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--fg-secondary)">開源模型隨裝隨換，GPU 卡位可擴充。換零件不換資料，授權不用重簽。</p>
            <span style={`${MONO};font-size:11px;color:var(--fg-tertiary)`}>圖為示意機型・實機配置以報價為準</span>
          </div>

          <div style={`position:absolute;left:50%;bottom:28px;transform:translateX(-50%);z-index:3;${MONO};font-size:12px;color:var(--fg-tertiary)`}>往下滑，拆開看 ↓</div>
        </div>
      </div>
    </section>

    <section style="padding:96px 0 48px">
      <div style={WRAP}>
        <span style={EYEBROW}>產品</span>
        <h1 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(30px,4.5vw,48px);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin:12px 0 16px">同一套系統，三個入口。</h1>
        <p style="font-size:16px;line-height:1.7;color:var(--fg-secondary);max-width:62ch;margin:0">六條產品線對應主控台六站：你從哪個角色進來，看到的就是你關心的那一面。</p>
      </div>
    </section>

    <section style="padding:0 0 96px;flex:1">
      <div style={WRAP}>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-bottom:48px">
          {lines.map((l) => (
            <div class="t-card">
              <p class="t-card__eyebrow">{l.eyebrow}</p>
              <h3 class="t-card__title">{l.title}</h3>
              <p class="t-card__body">{l.body}</p>
            </div>
          ))}
        </div>
        <div style="border:1px dashed var(--border-default);padding:48px;text-align:center">
          <p style={`margin:0;${MONO};font-size:12px;color:var(--fg-tertiary)`}>各產品詳情（受眾、賣點、功能區塊、FAQ）＝ Payload「Products」collection・填完發布即上線</p>
        </div>
      </div>
    </section>

    <FooterSlim />
  </div>
</Page>
