---
// 子頁的精簡 Footer（單列）。首頁用的是四欄完整版，另外一支。
// 來源：design/案例.dc.html 的 <footer>。
//
// 版權那一行吃後台的「全站設定 → 頁尾版權文字」，但只取公司名那一段，
// 因為這一列放不下首頁那種長版。後台沒填就用原本的字。
import { getSettings, text } from '../content';

const settings = await getSettings();
const copyright = text(settings, 'footerCopyright', '© 2026 虎智科技股份有限公司 TigerAI');
---

<footer style="background:#0E0E0D;color:#878480;padding:24px 0;font-size:12px">
  <div style="max-width:1440px;margin:0 auto;padding:0 clamp(16px,5vw,64px);display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between">
    <span>{copyright}</span>
    <a href="/" style="color:#B5B2AC;text-decoration:none">回首頁 →</a>
  </div>
</footer>
