---
// 開場 logo 動畫。純 CSS，不需要 JavaScript。
// 移植自 design/首頁.dc.html，時間軸一字不改：
//
//   0.1–1.8s   虎頭徽章（67×67）從 scale 4.15 淡入 → 3.65 → 3.83（律動）→ 1
//   1.6–2.5s   右側文字容器寬度 0 → 197px 展開，字像從虎頭後面被擠出來
//   1.65s 起   「T I G E R A I」七個字母依序由下 14px 淡入，每個差 0.12 秒
//              TIGER 是墨黑 #0E0E0D，AI 是虎金 #E89B2C
//   3.1s       整層往上滑出（translateY(-102%)，0.55 秒）
//
// SVG 的 path 直接取自 logo 原檔，不是重畫的。
//
// 「看過一次就不再播」的邏輯在 IntroGate.tsx 那邊統一處理（見那支檔），
// 這支只負責畫。

// 七個字母的 path，順序就是 T-I-G-E-R-A-I
const LETTERS = [
  { fill: '#0E0E0D', d: 'M109.23,13.76h-9.8v-7.27h28.39v7.27h-9.85v29.07h-8.73V13.76Z' },
  { fill: '#0E0E0D', d: 'M133.18,6.49h8.73v36.34h-8.73V6.49Z' },
  { fill: '#0E0E0D', d: 'M148.35,24.88c0-12.1,8.15-19.02,17.85-19.02,5.32,0,9.12,2.24,11.61,4.73l-4.59,5.56c-1.8-1.61-3.71-2.83-6.73-2.83-5.37,0-9.22,4.2-9.22,11.27s3.22,11.42,10,11.42c1.27,0,2.63-.34,3.41-.93v-5.85h-5.76v-7.12h13.51v16.98c-2.54,2.44-7.03,4.44-12.1,4.44-10.05,0-18-6.34-18-18.63Z' },
  { fill: '#0E0E0D', d: 'M185.52,6.49h23.03v7.27h-14.29v6.73h12.15v7.32h-12.15v7.71h14.83v7.32h-23.56V6.49Z' },
  { fill: '#0E0E0D', d: 'M228.93,30.05h-4.2v12.78h-8.73V6.49h13.32c7.76,0,14.2,2.68,14.2,11.46,0,5.32-2.49,8.73-6.24,10.49l8.1,14.39h-9.76l-6.68-12.78ZM228.64,23.17c4.15,0,6.39-1.8,6.39-5.22s-2.24-4.54-6.39-4.54h-3.9v9.76h3.9Z' },
  { fill: '#E89B2C', d: 'M267.9,6.49h10.44l11.27,36.34h-9.17l-2.1-8.34h-10.73l-2.1,8.34h-8.88l11.27-36.34ZM276.68,27.76l-.78-3.07c-.98-3.61-1.9-7.95-2.88-11.66h-.2c-.88,3.8-1.85,8.05-2.78,11.66l-.78,3.07h7.41Z' },
  { fill: '#E89B2C', d: 'M293.17,6.49h8.73v36.34h-8.73V6.49Z' },
];
const EASE = 'cubic-bezier(.22,.61,.36,1)';
---

<div
  data-intro-splash
  style={`position:fixed;inset:0;z-index:400;background:#FAFAF8;display:flex;align-items:center;justify-content:center;animation:tg-sp-out .55s ${EASE} 3.1s both`}
>
  <div style="display:flex;align-items:center">
    <img
      src="/assets/logo/color-square-mark.svg"
      alt="TigerAI"
      style="width:67px;height:67px;animation:tg-sp-mark 1.7s cubic-bezier(.45,.05,.25,1) .1s both"
    />
    <span style={`display:block;overflow:hidden;width:0;animation:tg-sp-w .9s ${EASE} 1.6s both`}>
      <svg viewBox="99 6 203 38" style="height:35px;width:187px;margin-left:10px;display:block" aria-label="TIGERAI">
        {LETTERS.map((l, i) => (
          <path fill={l.fill} style={`animation:tg-sp-ch .3s ${EASE} ${(1.65 + i * 0.12).toFixed(2)}s both`} d={l.d} />
        ))}
      </svg>
    </span>
  </div>
</div>
