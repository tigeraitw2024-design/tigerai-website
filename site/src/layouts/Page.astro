---
// 全站的 HTML 外殼。樣式表的載入順序照 design/*.dc.html 的 <helmet> 一字不差，
// 因為 CSS 的串接順序會影響最後長相，順序換了就可能走樣。
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** 深色底的頁面（例如首頁 Hero）要換 body 底色，預設暖白 #FAFAF8 */
  bodyBackground?: string;
  /**
   * 字型設定照原型分兩種，不要自己統一，差別會被像素比對抓到：
   *
   * standard（7 頁）：覆寫 :root 的 --font-sans／--font-display 指向思源黑體，
   *   所以設計系統的按鈕、卡片上的中文也是思源黑體。
   * tgpro（Tiger GPU Pro）：只改 body、沒動 :root，所以 .t-btn／.t-card 那些
   *   用 var(--font-sans) 的地方走 token 預設值，中文是 Noto Sans TC。
   *   body 的堆疊還多一個 'Noto Sans TC' 後備。
   */
  fonts?: 'standard' | 'tgpro';
}

const { title, description, bodyBackground, fonts = 'standard' } = Astro.props;
const DS = '/ds';

const FONT_CSS = {
  standard: `:root{--font-sans:'Inter','Source Han Sans TC',sans-serif;--font-display:'Manrope','Source Han Sans TC',sans-serif}` +
    `body{font-family:'Inter','Source Han Sans TC',sans-serif}`,
  tgpro: `body{font-family:'Inter','Source Han Sans TC','Noto Sans TC',sans-serif}`,
}[fonts];
---

<!DOCTYPE html>
<!-- translate="no" 是全站規則：防瀏覽器翻譯外掛把版面弄壞 -->
<html lang="zh-Hant" translate="no">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="website" />
  <link rel="icon" href="/assets/logo/color-square-mark.svg" type="image/svg+xml" />

  <!-- 設計系統。順序同原型：字型 → 自架中文 → 色彩 → 字級 → 基礎 → 元件 → 總表 -->
  <link rel="stylesheet" href={`${DS}/tokens/fonts.css`} />
  <link rel="stylesheet" href="/assets/fonts/source-han-sans-tc.css" />
  <link rel="stylesheet" href={`${DS}/tokens/colors.css`} />
  <link rel="stylesheet" href={`${DS}/tokens/typography.css`} />
  <link rel="stylesheet" href={`${DS}/styles/base.css`} />
  <link rel="stylesheet" href={`${DS}/styles/buttons.css`} />
  <link rel="stylesheet" href={`${DS}/styles/badges.css`} />
  <link rel="stylesheet" href={`${DS}/styles/cards.css`} />
  <link rel="stylesheet" href={`${DS}/styles.css`} />

  <style set:html={FONT_CSS} />
  {bodyBackground && <style set:html={`body{background:${bodyBackground}}`} />}

  <!-- 只有某一頁要的 keyframes 或樣式放這裡，不要塞進共用的 site.css。
       原型每頁的 inline <style> 除了共用那段之外還有各自的東西，
       例如免費資源的 tg-fade／tg-zoom，那些就從這個 slot 進來。 -->
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
