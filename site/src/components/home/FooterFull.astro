---
// 首頁的完整 Footer（四欄）。子頁用的是單列精簡版，在 FooterSlim.astro。
// 移植自 design/首頁.dc.html 的 11 區，文案一字不改。
//
// 隱私權政策和服務條款在原型裡是 href="#top" 的空連結。Robin 說這兩份內容
// 要一起處理，等文件寫好再把網址接上，現在先留空連結，跟原型一致。
const columns = [
  {
    title: '站內導覽',
    links: [
      { label: '產品：三個入口', href: '/products' },
      { label: 'Tiger GPU Pro 平台', href: '/products/tiger-gpu-pro' },
      { label: '課程 L1–L5', href: '/courses' },
      { label: '顧問與方法論', href: '/consultants' },
      { label: '案例', href: '/cases' },
      { label: '部落格', href: '/blog' },
    ],
  },
  {
    title: '免費資源',
    links: [
      { label: 'n8n 中文課程庫（獨立・非商業）', href: '/resources' },
      { label: 'Workflow 模板下載', href: '#workflows' },
      { label: '免費影片牆', href: '/resources' },
    ],
  },
  {
    title: '開始體驗',
    links: [
      { label: '5 分鐘 L 級測評', href: '#assessment' },
      { label: '開 30 分鐘沙盒', href: '#top' },
      { label: '預約 30 分鐘諮詢', href: '#contact' },
    ],
  },
];

const H5 = "font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#878480;margin:0 0 16px";
const LINK = 'color:#D7D5D1;text-decoration:none';
---

<footer style="background:#0E0E0D;color:#B5B2AC;padding:64px 0 32px;font-size:14px">
  <div style="max-width:1440px;margin:0 auto;padding:0 clamp(16px,5vw,64px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px">
      <div>
        <img src="/assets/logo/color-horizontal-white-text.svg" alt="TigerAI 虎智科技" style="height:32px;display:block" />
        <p style="max-width:32ch;margin:16px 0 0;color:#878480;font-size:13px;line-height:1.7">開源地端 AI × 可驗證的能力養成。從校內創業比賽第一名出發，臺科大傑出校友聯誼會與創新育成中心投資成立。</p>
      </div>
      {columns.map((c) => (
        <div>
          <h5 style={H5}>{c.title}</h5>
          <ul style="list-style:none;margin:0;padding:0;display:grid;gap:10px">
            {c.links.map((l) => (
              <li><a href={l.href} style={LINK}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;margin-top:48px;padding-top:24px;border-top:1px solid rgba(255,255,255,.1);font-size:12px;color:#878480">
      <span>© 2026 虎智科技股份有限公司 TigerAI · 開源地端 AI</span>
      <span style="display:flex;gap:16px">
        <a href="#top" style="color:#B5B2AC;text-decoration:none">隱私權政策</a>
        <a href="#top" style="color:#B5B2AC;text-decoration:none">服務條款</a>
      </span>
    </div>
  </div>
</footer>
