---
// 案例頁。移植自 design/案例.dc.html，版面與文案一字不改。
//
// 跟原型的差異只有兩處，都是刻意的：
//   1. 三個虛線佔位方框（原型用 <span style="border:1px dashed">）留著，
//      因為那是「這裡之後會有更多案例卡」的設計語彙，接上後台後由資料筆數決定。
//   2. 原型底下那行 mono 小字是給工程師看的欄位說明，不是給訪客看的文案，
//      接上後台之後就會拿掉。現在先留著當對照。
import Page from '../layouts/Page.astro';
import TopBar from '../components/TopBar.tsx';
import PartnerWall from '../components/PartnerWall.astro';
import FooterSlim from '../components/FooterSlim.astro';
import { getPartners } from '../content';

const partners = await getPartners();

// 成效卡。接上後台之後換成 Cases collection，客戶名稱一律不出現。
const cards = [
  { n: '半天 → 3 秒', industry: '製造業・報價單比對', mode: '模式：RAG 檢索＋Workflow 比對' },
  { n: '月省 96 小時', industry: '法務・合約審閱', mode: '模式：13 部門 AI 同事＋出處回覆' },
  { n: '首回 −72%', industry: '服務業・客服草擬', mode: '模式：知識庫＋首回流程' },
];
const PLACEHOLDERS = 3;
---

<Page
  title="案例｜TigerAI 虎智科技"
  description="每個案例都以「產業・痛點・方案・成果數字」呈現，客戶名稱一律不出現。形容詞不算證據。"
>
  <div style="min-height:100vh;display:flex;flex-direction:column">
    <TopBar current="cases" client:load />

    <section style="padding:140px 0 48px">
      <div style="max-width:1440px;margin:0 auto;padding:0 clamp(16px,5vw,64px)">
        <span style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--tiger-700)">案例</span>
        <h1 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(30px,4.5vw,48px);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin:12px 0 16px">只講模式，不講客戶機密。</h1>
        <p style="font-size:16px;line-height:1.7;color:var(--fg-secondary);max-width:56ch;margin:0">每個案例都以「產業・痛點・方案・成果數字」呈現，客戶名稱一律不出現。形容詞不算證據。</p>
      </div>
    </section>

    <section style="padding:0 0 96px;flex:1">
      <div style="max-width:1440px;margin:0 auto;padding:0 clamp(16px,5vw,64px)">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-bottom:32px">
          {cards.map((c) => (
            <div style="background:#fff;border:1px solid var(--border-subtle);padding:32px 24px">
              <b style="font-family:'Manrope',sans-serif;font-size:40px;font-weight:800;letter-spacing:-.02em;display:block">{c.n}</b>
              <p style="margin:8px 0 0;font-size:14px;line-height:1.7;color:var(--fg-secondary)">
                {c.industry}<br />{c.mode}
              </p>
            </div>
          ))}
          {Array.from({ length: PLACEHOLDERS }).map(() => (
            <span style="border:1px dashed var(--border-default);min-height:140px"></span>
          ))}
        </div>

        <p style="margin:0;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--fg-tertiary)">案例卡＝Payload「Cases」collection：客戶（不露出）、產業、痛點、方案、成果數字（必填）</p>

        <div style="margin-top:64px">
          <h2 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:30px;font-weight:800;letter-spacing:-.02em;margin:0 0 8px">合作夥伴</h2>
          <p style="margin:0 0 24px;font-size:14px;color:var(--fg-secondary)">{partners.length} 家企業、學校與法人。</p>
          <PartnerWall />
        </div>
      </div>
    </section>

    <FooterSlim />
  </div>
</Page>
