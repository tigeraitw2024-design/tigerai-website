---
// 首頁。移植自 design/首頁.dc.html，版面與文案一字不改。
//
// 這是全站最重的一頁。目前的移植狀態：
//
//   ✓ 00  開場 logo 動畫（3.1 秒時間軸，純 CSS）
//   ✓ 00  身分閘門（滑鼠光暈格線、捲動揭露、3D 傾斜、三身分輪播）
//   ✓ 01  Hero 筆電掀蓋 ＋ 馬賽克掃場標題 ＋ 開機動畫
//   ⚠ 01  筆電螢幕裡的主控台 8 站：待移植（原始碼 88 KB，最後做）
//   ✓ 02  信任帶（數字從 0 滾上來）
//   ✓ 03  立場宣言（左 sticky ＋ 四張痛點卡 ＋ 雲端 vs 地端對照表）
//   ✓ 04  產品入口三卡　✓ 04b Tiger GPU Pro 入口帶
//   ✓ 05  Workflow 展示櫃（節點鏈依序亮起）
//   ✓ 05b 企業首選左欄（6 條流程 ／ 13 部門互斥切換）
//   ⚠ 05b 右欄案卷（n8n 畫布、範例影片）：待移植
//   ✓ 06  測評入口（L1–L5 階梯長條生長）
//   ✓ 07  課程區　✓ 08 顧問與方法論（hover 去背人像滑入）
//   ✓ 09  案例與夥伴翻牌牆　✓ 10 三步預約卡　✓ 11 完整 Footer
//
// 原型的 showTourFab（右下角「帶我逛」）預設是 false，所以不顯示。
// 交付總綱裡的導覽模式是還沒做的功能，不是被砍掉。
import Page from '../layouts/Page.astro';
import '../styles/home.css';
import TopBar from '../components/TopBar.tsx';
import PartnerWall from '../components/PartnerWall.astro';
import { getPartners, getFlows, getDepts, getConsultants, getHome, text, num, list, strings } from '../content';
import IntroSplash from '../components/home/IntroSplash.astro';
import IdentityGate from '../components/home/IdentityGate.tsx';
import HeroLaptop from '../components/home/HeroLaptop.tsx';
import EnterpriseChoice from '../components/home/EnterpriseChoice.tsx';
import ConsultantStrip from '../components/home/ConsultantStrip.tsx';
import LeadForm from '../components/LeadForm.tsx';
import BookingCard from '../components/home/BookingCard.tsx';
import FooterFull from '../components/home/FooterFull.astro';
import ScrollReveal from '../components/home/ScrollReveal.astro';
import IconRiver from '../components/home/IconRiver.astro';

// 內容在建置時取得：有設 CONTENT_API 就去後台拿，沒設就用 src/data 與
// 下面寫死的預設值。兩種情況渲染出來的 HTML 一模一樣——這是刻意的，
// 後台接不上的時候網站不該跟著變樣。見 src/content。
const partners = await getPartners();
const flows = await getFlows();
const depts = await getDepts();
const consultants = await getConsultants();
const home = await getHome();

const MONO = "font-family:'JetBrains Mono',monospace";
const EYEBROW = `${MONO};font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--tiger-700)`;
const EYEBROW_DARK = `${MONO};font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#ECA42B`;
const WRAP = 'max-width:1440px;margin:0 auto;padding:0 clamp(16px,5vw,64px)';
const H2 = "font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(30px,4.5vw,48px);font-weight:800;letter-spacing:-.02em;line-height:1.1";
const SECTION = 'padding:clamp(56px,9vw,96px) 0';
const HOVER_CARD = 'transition:transform .12s cubic-bezier(.22,.61,.36,1),box-shadow .12s cubic-bezier(.22,.61,.36,1)';

// 03 立場宣言的四張痛點卡。後台「首頁文案 → ③ 立場宣言 - 四張卡」可以改。
const pains = list<{ n?: string; title: string; body: string }>(home, 'shadowCards', [
  { n: '01', title: '分散刷卡', body: '每人每月各訂各的，財務對不出一本總帳。' },
  { n: '02', title: '機密外流', body: '合約、報價、名單貼進雲端視窗，資料跟著提問出機房。' },
  { n: '03', title: '稽核斷點', body: '帳號共用、對話即刪，誰問了什麼，查不到。' },
  { n: '04', title: '供應商綁定', body: '漲價、改條款只能接受，資料還搬不走。' },
]).map((p, i) => ({ ...p, n: p.n || String(i + 1).padStart(2, '0') }));

// 雲端訂閱 vs 地端開源，左灰右白。後台存的是 {cloud, local} 物件陣列，
// 這裡轉回頁面本來吃的兩格陣列；後台沒填就用下面那份。
const compareFromCms = list<{ cloud: string; local: string }>(home, 'compare', [])
  .map((r) => [r.cloud, r.local] as [string, string]);
const compareFallback: [string, string][] = [
  ['資料跟著提問出機房', '資料不出機房，回應不經雲端 API'],
  ['每人每月訂閱，用越多繳越多', '一次建置，部門額度超標熔斷'],
  ['模型是租的，說換就得換', '開源模型隨裝隨換，授權不用重簽'],
  ['誰問了什麼，查不到', '紀錄留在你手上，過得了稽核'],
];
const compare = compareFromCms.length ? compareFromCms : compareFallback;

// 04 產品入口三卡
const entries = list<{ eyebrow: string; title: string; body: string }>(home, 'entries', [
  { eyebrow: '給老闆', title: '看得到錢與風險', body: '每個部門的 AI 花費與上限、資料留在機房的稽核證據、導入前後的工時對照。' },
  { eyebrow: '給主管', title: '看得到部門產出', body: '13 部門 AI 同事範本、知識庫問答有出處可回溯、流程改了誰都看得見。' },
  { eyebrow: '給工程師', title: '看得到底層，改得動', body: 'Ollama 模型隨裝隨換、n8n 流程節點自己改、LiteLLM 額度與熔斷設定。' },
]);

// 05 Workflow 展示櫃的節點鏈與三張卡
const chain = strings(home, 'chain', ['收到提問', '檢索合約庫', '條款比對', '附出處回覆']);
const wfCards = list<{ eyebrow: string; title: string; body: string }>(home, 'wfCards', [
  { eyebrow: '法務', title: '合約審閱流程', body: '五個節點，條款比對附出處，月省 96 小時。' },
  { eyebrow: '客服', title: '首回自動草擬', body: '知識庫檢索＋草稿生成，首回時間 −72%。' },
  { eyebrow: '業務', title: '報價單自動比對', body: '歷史報價檢索＋差異標示，半天縮成 3 秒。' },
]);

// 06 L1–L5 階梯
const ladder = list<{ l: string; w: string; on: boolean }>(home, 'ladder', [
  { l: 'L1', w: '20%', on: false },
  { l: 'L2', w: '36%', on: false },
  { l: 'L3', w: '52%', on: true },
  { l: 'L4', w: '68%', on: false },
  { l: 'L5', w: '84%', on: false },
]);

// 07 課程三卡
const courseCards = list<{ eyebrow: string; title: string; body: string }>(home, 'courseCards', [
  { eyebrow: 'L2・16 小時', title: 'n8n 自動化實戰', body: 'n8n Taiwan Ambassador 授課・學員 1,240+・政府補助適用（數字為版型示意）。' },
  { eyebrow: 'L3・12 小時', title: 'Advanced RAG 知識庫實作', body: '把文件變成問得到答案的知識庫・學員 680+（示意）。' },
  { eyebrow: 'L4・24 小時', title: '地端 LLM 導入與治理', body: 'Ollama＋LiteLLM 實機演練・學員 320+（示意）。' },
]);

// 02 信任帶的兩個數字。Robin 說過這些是真的資料，所以後台要能改。
const methodChips = strings(home, 'methodChips', ['C1–C5 思考力', '九維拆解', 'L.A.O.S. 拆題']);

// ④b 黑底後面那片流動的 App 圖示。後台可以關掉、調濃度、挑要放哪些。
const riverOn = home?.gpuRiver !== false;
const riverOpacity = num(home, 'gpuRiverOpacity', 10) / 100;
const riverIcons = Array.isArray(home?.gpuRiverIcons) ? (home!.gpuRiverIcons as string[]) : [];

const trustCompanies = num(home, 'trustCompanies', 166);
const trustStudents = num(home, 'trustStudents', 4085);
const trustTags = strings(home, 'trustTags', ['n8n Taiwan Ambassador', 'AMD 合作夥伴', '臺科大育成投資']);

// 09 三張成效卡。data-count 由 ScrollReveal 滾動上來。
const resultCards = list<{ pre: string; count: number; post: string; line1: string; line2: string }>(home, 'resultCards', [
  { pre: '半天 → ', count: 3, post: ' 秒', line1: '報價單比對・製造業', line2: '模式：RAG 檢索＋Workflow 比對' },
  { pre: '月省 ', count: 96, post: ' 小時', line1: '合約審閱・法務部門', line2: '模式：13 部門 AI 同事＋出處回覆' },
  { pre: '首回 −', count: 72, post: '%', line1: '客服草擬・服務業', line2: '模式：知識庫＋首回流程' },
]);
---

<Page
  title="TigerAI 虎智科技｜把 AI 變成你的員工"
  description="開源地端 AI × 可驗證的能力養成。你的資料不出機房，每個部門多一位 AI 同事。"
>
  <Fragment slot="head">
    <!-- 「看過一次就不再播」：在繪製前就判斷完，避免開場動畫閃一下才消失。
         Robin 指定的行為。

         兩個網址參數，給檢查畫面的時候用：
           ?intro   無視「看過了」的記號，強制從頭播一次開場與身分閘門
           ?nogate  相反，直接跳過開場看首頁內容

         判斷寫在這支最早執行的腳本裡，後面的 CSS 規則與 React 元件都是看
         它掛上去的 data 屬性，所以改這裡一處就夠，不用每個地方各判斷一次。 -->
    <script is:inline>
      try {
        var forceIntro = /[?&]intro\b/.test(location.search);
        if (!forceIntro && localStorage.getItem('tg-intro-seen') === '1') {
          document.documentElement.dataset.tgIntroSeen = '1';
          document.documentElement.dataset.tgBoot = '1';
        }
      } catch (e) {
        // 無痕視窗或封鎖網站資料，當作沒看過，照常播
      }
    </script>
    <style>
      /* 「看過一次就不再播」的兩條規則搬到 src/styles/home.css 了。
         寫在這裡會被 Astro 加上元件範圍限定（[data-astro-cid-...]），
         而開場層與閘門都不是這一頁自己的元素，規則會對不到。見那邊的說明。 */
      /* 原型用 support.js 的 style-hover，這裡換成真 CSS */
      .tg-hovercard:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg) }
      .tg-skipgate:hover { color: #0E0E0D }
      .tg-echoice-row:hover, .tg-echoice-swap:hover { background: var(--slate-50) }
      .tg-bkopt:hover, .tg-bkslot:hover, .tg-bknav:hover { border-color: var(--ink-600) }
      .tg-bkzoom:hover { border-color: var(--ink-600) }
      @media (prefers-reduced-motion: reduce) {
        .tg-hovercard { transition: none }
      }
    </style>
  </Fragment>

  <div id="top" translate="no" style="min-height:100vh">
    <IntroSplash />
    <IdentityGate client:load />
    <TopBar startFrom="[data-trust-band]" client:load />

    <!-- 01 Hero 筆電開場 -->
    <section style="background:#0E0E0D;color:#fff;padding:clamp(120px,18vw,160px) 0 clamp(40px,6vw,64px);position:relative;overflow:hidden">
      <div style="position:absolute;top:-30%;right:-8%;width:520px;height:520px;background:radial-gradient(closest-side,rgba(236,164,43,.28),transparent 70%);pointer-events:none;animation:tg-drift 14s ease-in-out infinite alternate"></div>
      <div style={`${WRAP};position:relative;display:flex;flex-direction:column;align-items:center;text-align:center`}>
        <HeroLaptop client:load />
      </div>
    </section>

    <!-- 02 信任帶。頂欄的縮放起點是這一區的底部，所以要留 data-trust-band。 -->
    <section data-trust-band style="background:#fff;border-bottom:1px solid var(--border-subtle)">
      <div data-m="pad" style="max-width:1440px;margin:0 auto;padding:24px 64px;display:flex;flex-wrap:wrap;align-items:center;gap:16px 64px">
        <span style="display:flex;align-items:baseline;gap:8px">
          <b style="font-family:'Manrope',sans-serif;font-size:30px;font-weight:800;letter-spacing:-.02em"><span data-count={String(trustCompanies)}>{trustCompanies}</span>+</b>
          <span style="font-size:13px;color:var(--fg-secondary)">企業導入</span>
        </span>
        <span style="width:1px;height:28px;background:var(--border-subtle)"></span>
        <span style="display:flex;align-items:baseline;gap:8px">
          <b style="font-family:'Manrope',sans-serif;font-size:30px;font-weight:800;letter-spacing:-.02em"><span data-count={String(trustStudents)} data-comma="1">{trustStudents.toLocaleString('en-US')}</span>+</b>
          <span style="font-size:13px;color:var(--fg-secondary)">學員結業</span>
        </span>
        <span style="width:1px;height:28px;background:var(--border-subtle)"></span>
        <span style="display:flex;gap:12px;flex-wrap:wrap">
          {trustTags.map((t) => (
            <span class="t-badge t-badge--brand">{t}</span>
          ))}
        </span>
      </div>
    </section>

    <!-- 03 立場宣言 -->
    <section style={SECTION}>
      <div style={`${WRAP};display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:48px;align-items:start`}>
        <div style="position:sticky;top:120px">
          <span style={EYEBROW}>Shadow AI Spend</span>
          <h2 style={`${H2};margin:12px 0 16px`}>{text(home, 'shadowTitle', "錢和資料，正在一起流出去。")}</h2>
          <p style="font-size:16px;line-height:1.7;color:var(--fg-secondary);max-width:40ch;margin:0">{text(home, 'shadowBody', "員工自己刷卡訂 ChatGPT、Claude、Gemini：財務看到的是零碎小額，資安看不到貼進雲端的機密。這不是「導入好難」，是 Shadow AI Spend。")}</p>
        </div>
        <div style="display:grid;gap:24px">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
            {pains.map((p) => (
              <div class="tg-hovercard" style={`background:#fff;border:1px solid var(--border-subtle);padding:24px;${HOVER_CARD}`}>
                <span style={`${MONO};font-size:11px;color:var(--fg-tertiary)`}>{p.n}</span>
                <h3 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:18px;font-weight:700;margin:8px 0 6px">{p.title}</h3>
                <p style="margin:0;font-size:14px;line-height:1.7;color:var(--fg-secondary)">{p.body}</p>
              </div>
            ))}
          </div>
          <div style="border:1px solid var(--border-subtle);background:#fff">
            <div style="display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--border-subtle)">
              <span style={`padding:12px 24px;${MONO};font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg-tertiary)`}>雲端訂閱</span>
              <span style={`padding:12px 24px;${MONO};font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--tiger-700);border-left:1px solid var(--border-subtle)`}>地端開源</span>
            </div>
            {compare.map(([cloud, local], i) => (
              <div style={`display:grid;grid-template-columns:1fr 1fr${i < compare.length - 1 ? ';border-bottom:1px solid var(--border-subtle)' : ''}`}>
                <span style="padding:16px 24px;font-size:14px;line-height:1.7;color:var(--fg-secondary);background:var(--slate-50)">{cloud}</span>
                <span style="padding:16px 24px;font-size:14px;line-height:1.7;border-left:1px solid var(--border-subtle)">{local}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 04 產品入口 -->
    <section id="products" style={`${SECTION};background:#fff;border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)`}>
      <div style={WRAP}>
        <span style={EYEBROW}>產品入口</span>
        <h2 style={`${H2};margin:12px 0 16px`}>{text(home, 'productsTitle', "同一套系統，三個入口。")}</h2>
        <p style="font-size:18px;line-height:1.7;color:var(--fg-secondary);max-width:62ch;margin:0 0 32px">{text(home, 'productsBody', "Local GPT 硬體、AI 服務啟動、GPU 資源管理，三條產品線其實是同一套系統。你從哪個角色進來，看到的就是你關心的那一面。")}</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-bottom:32px">
          {entries.map((e) => (
            <div class="t-card">
              <p class="t-card__eyebrow">{e.eyebrow}</p>
              <h3 class="t-card__title">{e.title}</h3>
              <p class="t-card__body">{e.body}</p>
            </div>
          ))}
        </div>
        <a href="/products" style="font-size:14px;font-weight:600;color:var(--tiger-700);text-decoration:none">進產品頁，看六條產品線 →</a>
      </div>
    </section>

    <!-- 04b Tiger GPU Pro 入口帶 -->
    <section id="tg-pro" style="background:#0E0E0D;color:#fff;padding:56px 0;position:relative;overflow:hidden">
      {riverOn && <IconRiver slugs={riverIcons} opacity={riverOpacity} rows={5} />}
      <div style="position:absolute;top:-60%;right:-4%;width:380px;height:380px;background:radial-gradient(closest-side,rgba(236,164,43,.24),transparent 70%);pointer-events:none;z-index:1"></div>
      <div data-m="pad" style="max-width:1440px;margin:0 auto;padding:0 64px;position:relative;z-index:2;display:flex;align-items:center;gap:24px;flex-wrap:wrap">
        <div style="flex:1;min-width:280px">
          <span style={EYEBROW_DARK}>Tiger GPU Pro・新上線</span>
          <h2 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.02em;line-height:1.15;margin:10px 0 8px">{text(home, 'gpuTitle', "做出來了，放哪裡？")}</h2>
          <p style="font-size:15px;line-height:1.7;color:#B5B2AC;margin:0;max-width:52ch">{text(home, 'gpuBody', 'AI 幫你把 Agent、網站、App 都寫完了。部署、算力、控管的最後一哩，Tiger GPU Pro 鋪好，兩端 AI 自己談部署。')}</p>
        </div>
        <a href="/products/tiger-gpu-pro" style="text-decoration:none"><button class="t-btn t-btn--primary t-btn--lg">{text(home, 'gpuCta', '看 Tiger GPU Pro →')}</button></a>
      </div>
    </section>

    <!-- 05 Workflow 展示櫃 -->
    <section id="workflows" style={SECTION}>
      <div style={WRAP}>
        <span style={EYEBROW}>Workflow 展示櫃</span>
        <h2 style={`${H2};margin:12px 0 32px`}>{text(home, 'workflowTitle', "看得見、改得動、過得了稽核的 SOP。")}</h2>
        <div data-chain="1" style={`display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:32px;${MONO};font-size:13px`}>
          {chain.map((c) => (
            <>
              <span style="border:1px solid var(--border-strong);padding:8px 12px;background:#fff">{c}</span>
              <span style="color:var(--tiger-600)">→</span>
            </>
          ))}
          <span style="border:1px solid var(--border-brand);padding:8px 12px;background:var(--tiger-50)">逾標開單</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-bottom:32px">
          {wfCards.map((c) => (
            <div class="t-card">
              <p class="t-card__eyebrow">{c.eyebrow}</p>
              <h3 class="t-card__title">{c.title}</h3>
              <p class="t-card__body">{c.body}</p>
            </div>
          ))}
        </div>
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;background:#fff;border:1px solid var(--border-subtle);padding:24px">
          <span style="font-size:14px;color:var(--fg-secondary);margin-right:auto;max-width:44ch;line-height:1.7">節點可點、模板可下載：留 Email，模板 JSON 直接寄給你。</span>
          <LeadForm source="workflow-template" client:visible />
        </div>
      </div>
    </section>

    <!-- 05b 企業首選 -->
    <section id="departments" style="padding:96px 0;background:#fff;border-top:1px solid var(--border-subtle)">
      <div data-m="pad" style="max-width:1440px;margin:0 auto;padding:0 64px">
        <EnterpriseChoice flows={flows} depts={depts} client:load />
      </div>
    </section>

    <!-- 06 測評入口 -->
    <section id="assessment" style={`${SECTION};background:#fff;border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)`}>
      <div data-m="stack" style={`${WRAP};display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:48px;align-items:center`}>
        <div>
          <span style={EYEBROW}>L1–L5 成熟度</span>
          <h2 style={`${H2};margin:12px 0 16px`}>{text(home, 'assessTitle', "5 分鐘，測你在 L 幾。")}</h2>
          <p style="font-size:16px;line-height:1.7;color:var(--fg-secondary);max-width:44ch;margin:0 0 32px">題目和計分都是 AX Academy 的：中立的診斷方，不是虎智自家測驗。測完直接對應：該上哪門課、該導哪一階產品。</p>
          <a href="https://tigeraiax-academy.pages.dev/assessment.html" target="_blank" rel="noopener" style="text-decoration:none"><button class="t-btn t-btn--outline t-btn--lg">去 AX Academy 測評 →</button></a>
        </div>
        <div data-lbars="1" style="display:grid;gap:8px">
          {ladder.map((r) => (
            <div style="display:flex;align-items:center;gap:16px">
              <span style={`${MONO};font-size:13px;width:32px`}>{r.l}</span>
              <span style={`height:32px;width:${r.w};background:var(--${r.on ? 'tiger-100' : 'slate-100'});border:1px solid var(--${r.on ? 'border-brand' : 'border-subtle'})`}></span>
            </div>
          ))}
          <p style="margin:8px 0 0;font-size:13px;color:var(--fg-tertiary)">先測 L 幾，再決定上什麼課、導哪一階，三件事用同一把尺。</p>
        </div>
      </div>
    </section>

    <!-- 07 課程區 -->
    <section id="courses" style={SECTION}>
      <div style={WRAP}>
        <span style={EYEBROW}>課程 L1–L5</span>
        <h2 style={`${H2};margin:12px 0 32px`}>{text(home, 'coursesTitle', "從會用，到自己跑得動。")}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-bottom:32px">
          {courseCards.map((c) => (
            <div class="t-card">
              <p class="t-card__eyebrow">{c.eyebrow}</p>
              <h3 class="t-card__title">{c.title}</h3>
              <p class="t-card__body">{c.body}</p>
            </div>
          ))}
        </div>
        <a href="/courses" style="font-size:14px;font-weight:600;color:var(--tiger-700);text-decoration:none">看全部課程與價格 →</a>
      </div>
    </section>

    <!-- 08 顧問與方法論 -->
    <section id="methodology" style={`background:#0E0E0D;color:#fff;${SECTION};position:relative`}>
      <div style="position:absolute;inset:0;overflow:hidden;pointer-events:none">
        <div style="position:absolute;top:-40%;right:-6%;width:480px;height:480px;background:radial-gradient(closest-side,rgba(236,164,43,.28),transparent 70%);animation:tg-drift 14s ease-in-out infinite alternate"></div>
      </div>
      <div style={`${WRAP};position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:48px;align-items:center`}>
        <div>
          <span style={EYEBROW_DARK}>顧問與方法論</span>
          <h2 style={`${H2};margin:12px 0 16px`}>{text(home, 'methodTitle', "顧問的腦，怎麼驗證？")}</h2>
          <p style="font-size:16px;line-height:1.7;color:#B5B2AC;max-width:52ch;margin:0 0 24px">{text(home, 'methodBody', "C1–C5 是顧問思考能力的尺，搭配九維拆解與 L.A.O.S. 拆題框架：方法公開，過程可驗，不靠形容詞。")}</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:32px">
            {methodChips.map((t) => (
              <span style={`${MONO};font-size:12px;border:1px solid rgba(255,255,255,.22);padding:6px 12px`}>{t}</span>
            ))}
          </div>
          <a href="/consultants" style="font-size:14px;font-weight:600;color:#ECA42B;text-decoration:none">認識顧問群 →</a>
        </div>
        <ConsultantStrip data={consultants} client:load />
      </div>
    </section>

    <!-- 09 案例與夥伴 -->
    <section id="cases" style={`${SECTION};background:#fff;border-bottom:1px solid var(--border-subtle)`}>
      <div style={WRAP}>
        <span style={EYEBROW}>案例</span>
        <h2 style={`${H2};margin:12px 0 32px`}>{text(home, 'casesTitle', "只講模式，不講客戶機密。")}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-bottom:48px">
          {resultCards.map((c) => (
            <div class="tg-hovercard" style={`border:1px solid var(--border-subtle);padding:32px 24px;${HOVER_CARD}`}>
              <b style="font-family:'Manrope',sans-serif;font-size:40px;font-weight:800;letter-spacing:-.02em;display:block">
                {c.pre}<span data-count={String(c.count)}>{c.count}</span>{c.post}
              </b>
              <p style="margin:8px 0 0;font-size:14px;line-height:1.7;color:var(--fg-secondary)">{c.line1}<br />{c.line2}</p>
            </div>
          ))}
        </div>
        <div style="display:flex;align-items:baseline;gap:16px;margin-bottom:16px">
          <span style={`${MONO};font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg-tertiary)`}>合作夥伴</span>
          <span style="font-size:13px;color:var(--fg-tertiary)">{partners.length} 家企業、學校與法人</span>
        </div>
        <PartnerWall />
      </div>
    </section>

    <!-- 10 收尾 CTA：左虎金右白，中線剛好切在一半 -->
    <section id="contact" data-m="cta" style="background:linear-gradient(90deg,var(--tiger-500) 50%,#FFFFFF 50%);color:#0E0E0D;padding:0">
      <div style={`${WRAP};display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));column-gap:0;row-gap:32px;align-items:center`}>
        <div style="padding-right:clamp(24px,5vw,64px)">
          <h2 style="font-family:'Manrope','Noto Sans TC',sans-serif;font-size:clamp(34px,5vw,60px);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin:0 0 16px">{text(home, 'ctaTitle', "預約 30 分鐘諮詢。")}</h2>
          <p style="font-size:18px;line-height:1.7;color:#1A1918;max-width:52ch;margin:0">{text(home, 'ctaBody', "帶著你最痛的那個部門來。我們會告訴你這件事該用哪一階、要多少算力、資料怎麼留在機房。")}</p>
        </div>
        <BookingCard client:load />
      </div>
    </section>

    <FooterFull />
    <ScrollReveal />
  </div>
</Page>
